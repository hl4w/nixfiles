# 硬件公共配置
# 包含所有主机类型共享的基础硬件配置
{ pkgs, lib, ... }:

{
  # ============================================
  # 内核参数
  # ============================================
  # 特定 GPU 参数由 install.sh 根据硬件检测结果添加
  boot.kernelParams = [
    "iommu=pt"  # IOMMU 直通模式
  ];

  # ============================================
  # 显卡配置 (NixOS 24.11+)
  # ============================================
  # 启用 Mesa 图形驱动（支持 OpenGL/Vulkan）
  # 注意：桌面环境模块通常会自动设置这些选项
  hardware.graphics.enable = true;

  # ============================================
  # 网络管理
  # ============================================
  # NetworkManager 已在 NixOS 26.05 中成为桌面安装的默认选择
  # 用户需要添加到 networkmanager 组才能配置网络
  # (已在 hosts/common/default.nix 中通过 extraGroups 配置)

  # ============================================
  # 音频配置
  # ============================================
  # 详细音频配置请参见 modules/hardware/sound.nix
  # 包含：rtkit + PipeWire + PulseAudio 兼容性
}
